{
  "name": "dsh-session-manager",
  "version": "0.2.0",
  "description": "DSH plugin: permanently delete sessions from disk. Adds a button to the session header that lists all persisted sessions and lets you move unwanted ones to the OS trash.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-modules"
      ],
      "platform": "web"
    }
  },
  "dependencies": {}
}
